# ── DEPENDENCIES ──────────────────────────────────────────────────────────────
# Never upload node_modules; they are huge and recreated via 'npm install'
node_modules/
dist/
build/
.cache/

# ── SECRET DATA & CREDENTIALS ───────────────────────────────────────────────
# CRITICAL: Keep your MongoDB URI and API keys off GitHub
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# ── OPERATING SYSTEM FILES ──────────────────────────────────────────────────
# Specific to your MacBook Pro (prevents those annoying .DS_Store files)
.DS_Store
.AppleDouble
.LSOverride
Icon?
._*

# ── LOGS & DEBUGGING ────────────────────────────────────────────────────────
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
logs
*.log

# ── IDE SETTINGS ───────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
